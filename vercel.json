{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "static"
      }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/verification/digilocker/url",
      "dest": "/api/verification/digilocker/url.js"
    },
    {
      "src": "/api/verification/digilocker/status/(.*)",
      "dest": "/api/verification/digilocker/status/[verification_id].js?verification_id=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
